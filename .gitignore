# ══════════════════════════════════════════════════════════
# OFICINAFUTURE — Unified .gitignore
# ══════════════════════════════════════════════════════════

# ── AI Agent / Template Files ─────────────────────────
.agent/
.specify/

# ── OS Files ──────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.pem

# ── Windows Binaries ─────────────────────────────────
*.exe
*.winmd

# ── IDE ───────────────────────────────────────────────
.vscode/
.vscode-test
.idea/
*.swp
*.swo
*~

# ── Environment ───────────────────────────────────────
.env
.env.*
.env.local
.env.*.local
!.env.example
!backend/.env.example

# ── Logs ──────────────────────────────────────────────
*.log
logs
npm-debug.*
npm-debug.log*
yarn-debug.*
yarn-error.*
lerna-debug.log*

# ── Runtime Data ──────────────────────────────────────
pids
*.pid
*.seed
*.pid.lock

# ══════════════════════════════════════════════════════════
# PYTHON / BACKEND
# ══════════════════════════════════════════════════════════

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Virtual Environments
.venv/
.venv-local/
venv/

# Django
backend/db.sqlite3
backend/db_local.sqlite3
backend/local_settings_override.py
backend/staticfiles/
backend/media/

# ══════════════════════════════════════════════════════════
# NODE / FRONTEND
# ══════════════════════════════════════════════════════════

# Dependencies
node_modules/
jspm_packages/
web_modules/
bower_components

# Expo / React Native
.expo/
.tmp-export/
expo-env.d.ts
.metro-health-check*
.kotlin/
*.orig.*
frontend/ios/
frontend/android/

# Native signing keys
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Build output
dist/
build/
build/Release
web-build/
out

# TypeScript
*.tsbuildinfo

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Coverage
coverage
*.lcov
.nyc_output
lib-cov

# Caches
.cache
.cache/
.parcel-cache
.npm
.eslintcache
.stylelintcache
.grunt
.temp

# Next.js
.next

# Nuxt.js
.nuxt

# Vuepress
.vuepress/dist

# Sveltekit
.svelte-kit/

# Vitepress
**/.vitepress/dist
**/.vitepress/cache

# Docusaurus
.docusaurus

# Serverless
.serverless/

# FuseBox
.fusebox/

# DynamoDB Local
.dynamodb/

# Firebase
.firebase/

# TernJS
.tern-port

# REPL history
.node_repl_history

# npm pack output
*.tgz

# Yarn
.yarn-integrity
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.lock-wscript

# Vite logs
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# ══════════════════════════════════════════════════════════
# PROJECT-SPECIFIC
# ══════════════════════════════════════════════════════════

frontend/src/app/services/server.js
